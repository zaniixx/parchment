---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}{{ '/feed.xml' | url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}{{ '/' | url }}"/>
  <updated>{{ buildTime.toISOString() }}</updated>
  <id>{{ site.url }}{{ '/' | url }}</id>
  <author><name>{{ site.author }}</name></author>

  {% for item in collections.writing | reverse %}
  <entry>
    <title>{{ item.data.title or (item.templateContent | truncate(60)) }}</title>
    <link href="{{ site.url }}{{ item.url | url }}"/>
    <updated>{{ item.date.toISOString() }}</updated>
    <id>{{ site.url }}{{ item.url | url }}</id>
    <content type="html">{{ item.templateContent }}</content>
  </entry>
  {% endfor %}
</feed>
